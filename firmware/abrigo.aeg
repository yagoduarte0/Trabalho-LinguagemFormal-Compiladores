// AEGIS — firmware do abrigo (ESP32 DevKit V1)
//
// Compilar para a placa (ou para o Wokwi):
//   node compilador/aegisc.js firmware/abrigo.aeg --alvo esp32 -o firmware/main.py
//
// Cada sensor tem um survivor que lê o valor e classifica o risco em
// NORMAL, ATENCAO ou ALARME. A cada ciclo o pior risco decide os LEDs, o
// buzzer, o display e o aviso pela rede. Funciona sem internet: a rede é
// só um canal a mais quando existe.

scavenge gpio
scavenge adc
scavenge sonar
scavenge climate
scavenge display
scavenge pwm
scavenge wifi
scavenge mqtt
scavenge time
scavenge finger

// ------------------------------------------------------------------
// Pinos — mapa completo em docs/hardware.md
// ------------------------------------------------------------------
law PINO_PIR = 27
law PINO_TRIG = 25
law PINO_ECHO = 26
law PINO_DHT = 4
law PINO_MQ2 = 34          // ADC1: o ADC2 não funciona com o WiFi ligado
law PINO_MQ135 = 35
law PINO_BOTAO = 14        // botão entre o pino e o GND
law PINO_BUZZER = 18
law LED_VERDE = 13
law LED_AMARELO = 33
law LED_VERMELHO = 32
law PINO_CHUVA = 36        // VP: só entrada, ADC1
law PINO_SOLO = 39         // VN: só entrada, ADC1
law PINO_RELE = 23         // exaustor ou sirene externa
law PINO_DIGITAL_RX = 16   // RX2 do ESP32 <- TX do AS608
law PINO_DIGITAL_TX = 17   // TX2 do ESP32 -> RX do AS608

// ------------------------------------------------------------------
// Limites — calibrar com os sensores reais (docs/hardware.md, seção 5)
// ------------------------------------------------------------------
// MQ-2 e MQ-135 não têm escala absoluta confiável (cada unidade e o
// simulador dão valores diferentes para o mesmo ar) e a leitura crua é
// ruidosa. O firmware filtra a leitura, aprende a base de ar limpo no
// aquecimento e alarma pela subida acima dela. Fora do alarme, a base
// acompanha devagar a deriva lenta do sensor; a fumaça sobe em segundos e
// passa da margem antes que a base a alcance. A histerese evita
// liga-desliga quando a leitura oscila perto do limite.
law MARGEM_FUMACA = 800    // MQ-2: alarme quando passa de base + 800 (escala 0..4095)
law HISTERESE_FUMACA = 300 // ...e só desliga abaixo de base + 500
law MARGEM_AR = 800        // MQ-135: atenção quando passa de base + 800
law HISTERESE_AR = 300
law FILTRO_MQ = 4          // média móvel: cada leitura nova pesa 1/4
law ADAPTA_BASE = 64       // a base anda 1/64 da diferença por ciclo (~30 s)
law LIMITE_AGUA_CM = 20.0  // sensor no alto, olhando para baixo: água perto = enchente
law TEMP_ATENCAO = 40.0
law TEMP_ALARME = 55.0
// Chuva e solo: os dois sensores leem mais alto secos e caem com a água.
// SECO e MOLHADO são as leituras (0..4095) nos dois extremos; o firmware
// converte para % de molhado. Calibrar com o sensor real.
law CHUVA_SECO = 4095
law CHUVA_MOLHADO = 1000
law SOLO_SECO = 2900       // capacitivo v1.2 no ar, a 3,3 V
law SOLO_MOLHADO = 1100    // ...e dentro de um copo d'água
law CHUVA_ATENCAO = 30     // % a partir do qual está chovendo
law SOLO_ATENCAO = 70      // % de solo encharcado
law SOLO_ALARME = 85       // chuva + solo acima disso: risco de deslizamento
law HISTERESE_PCT = 10
law RELE_ATIVO_EM_ALTO = alive // módulos com optoacoplador ligam em nível baixo: use dead
law RELE_EXTRA_MS = 30000  // o exaustor segue ligado depois que a fumaça some
// Armado (casa vazia): presença vira alarme de intruso. Como nos alarmes
// comerciais, há um tempo para sair depois de armar e um tempo para pôr a
// digital depois de entrar.
law ATRASO_SAIDA_MS = 30000
law ATRASO_ENTRADA_MS = 15000
law AQUECIMENTO_MS = 20000 // os MQ dão leituras falsas enquanto esquentam
law SILENCIO_MS = 60000    // quanto tempo o botão cala o buzzer
law CICLO_MS = 500
law TELEMETRIA_MS = 10000
law DEPURAR = alive        // imprime as leituras cruas no serial (calibração)
law DEPURAR_MS = 2000

// ------------------------------------------------------------------
// Rede — opcional. "Wokwi-GUEST" é a rede aberta do simulador.
// ------------------------------------------------------------------
law USAR_REDE = alive
law WIFI_SSID = "Wokwi-GUEST"
law WIFI_SENHA = ""
law MQTT_BROKER = "broker.hivemq.com"

// ------------------------------------------------------------------
// Estados
// ------------------------------------------------------------------
law NORMAL = 0
law ATENCAO = 1
law ALARME = 2
stash NOMES_ESTADO = ["NORMAL", "ATENCAO", "ALARME"]

// ------------------------------------------------------------------
// Memória do firmware
// ------------------------------------------------------------------
supply inicio = 0
supply aquecido = dead
supply amostras = 0
supply filtro_pronto = dead
supply media_fumaca = 0
supply media_ar = 0
supply base_fumaca = 0
supply base_ar = 0
supply base_registrada = dead

supply leitura_fumaca = 0
supply leitura_ar = 0
supply distancia_agua = 0.0
supply temperatura = 0.0
supply umidade = 0.0
supply presenca = dead
supply leitura_chuva = 0
supply media_chuva = 0
supply chuva_pct = 0
supply leitura_solo = 0
supply media_solo = 0
supply solo_pct = 0
supply chovendo = dead
supply solo_encharcado = dead
supply deslizamento = dead
supply rele_ligado = dead
supply houve_fumaca = dead
supply ultima_fumaca = 0
supply digital = -1
supply armado = dead
supply armado_em = 0
supply em_entrada = dead
supply entrada_em = 0
supply intruso = dead

supply risco_fumaca = 0
supply risco_ar = 0
supply risco_agua = 0
supply risco_calor = 0
supply risco_presenca = 0

supply estado = 0
supply estado_anterior = -1
supply motivo = "tudo em ordem"
supply motivo_anterior = ""

supply silenciado = dead
supply silencio_desde = 0
supply sirene_alta = dead
supply rede = dead
supply ultima_telemetria = 0
supply ultima_depuracao = 0

// ------------------------------------------------------------------
// Sentinelas: um por sensor
// ------------------------------------------------------------------

// MQ-2: fumaça e gás inflamável. A decisão usa a média filtrada, nunca a
// leitura crua. No aquecimento a base segue a média (no fim, é o ar limpo).
// Depois: acima de base + MARGEM liga o alarme, abaixo de
// base + MARGEM - HISTERESE desliga; no meio, mantém o que estava.
survivor sentinela_fumaca {
    leitura_fumaca = adc.read(radio(PINO_MQ2))
    checkpoint (filtro_pronto) {
        media_fumaca = media_fumaca + ration((leitura_fumaca - media_fumaca) / FILTRO_MQ)
    } fallback {
        media_fumaca = leitura_fumaca
    }
    checkpoint (!aquecido) {
        base_fumaca = media_fumaca
        risco_fumaca = NORMAL
    } fallback checkpoint (media_fumaca >= base_fumaca + MARGEM_FUMACA) {
        risco_fumaca = ALARME
    } fallback checkpoint (media_fumaca < base_fumaca + MARGEM_FUMACA - HISTERESE_FUMACA) {
        risco_fumaca = NORMAL
    }
    checkpoint (aquecido && risco_fumaca == NORMAL) {
        base_fumaca = base_fumaca + ration((media_fumaca - base_fumaca) / ADAPTA_BASE)
    }
}

// MQ-135: qualidade do ar (CO2, amônia, fumaça leve), mesma lógica
survivor sentinela_ar {
    leitura_ar = adc.read(radio(PINO_MQ135))
    checkpoint (filtro_pronto) {
        media_ar = media_ar + ration((leitura_ar - media_ar) / FILTRO_MQ)
    } fallback {
        media_ar = leitura_ar
    }
    checkpoint (!aquecido) {
        base_ar = media_ar
        risco_ar = NORMAL
    } fallback checkpoint (media_ar >= base_ar + MARGEM_AR) {
        risco_ar = ATENCAO
    } fallback checkpoint (media_ar < base_ar + MARGEM_AR - HISTERESE_AR) {
        risco_ar = NORMAL
    }
    checkpoint (aquecido && risco_ar == NORMAL) {
        base_ar = base_ar + ration((media_ar - base_ar) / ADAPTA_BASE)
    }
}

// HC-SR04: distância até a superfície da água; -1 quando não há eco
survivor sentinela_agua {
    distancia_agua = sonar.distance(radio(PINO_TRIG), radio(PINO_ECHO))
    risco_agua = NORMAL
    checkpoint (distancia_agua > 0.0 && distancia_agua < LIMITE_AGUA_CM) {
        risco_agua = ALARME
    }
}

// DHT22: temperatura e umidade; -1 quando a leitura falha
survivor sentinela_calor {
    temperatura = climate.temperature(radio(PINO_DHT))
    umidade = climate.humidity(radio(PINO_DHT))
    risco_calor = NORMAL
    checkpoint (temperatura >= TEMP_ALARME) {
        risco_calor = ALARME
    } fallback checkpoint (temperatura >= TEMP_ATENCAO) {
        risco_calor = ATENCAO
    }
}

// Bipes curtos de resposta ao leitor de digital
mission bipar(ration vezes) {
    patrol (vezes) {
        pwm.tone(radio(PINO_BUZZER), 3000)
        hide(80)
        pwm.off(radio(PINO_BUZZER))
        hide(80)
    }
}

// Leitor de digital: cada digital cadastrada alterna armado/desarmado
survivor vigia_digital {
    digital = finger.scan()
    checkpoint (digital >= 0) {
        armado = !armado
        em_entrada = dead
        intruso = dead
        checkpoint (armado) {
            armado_em = time.ms()
            log_entry("[AEGIS] armado pela digital", digital, "- saia em", ATRASO_SAIDA_MS / 1000, "s")
        } fallback {
            log_entry("[AEGIS] desarmado pela digital", digital)
        }
        bipar(1)
    } fallback checkpoint (digital == -2) {
        log_entry("[AEGIS] digital nao reconhecida")
        bipar(3)
    }
}

// PIR: desarmado (alguém em casa) é ignorado. Armado, depois do tempo de
// saída, presença abre o tempo de entrada; sem digital até o fim dele,
// vira alarme de intruso.
survivor sentinela_presenca {
    presenca = gpio.read(radio(PINO_PIR))
    checkpoint (armado && presenca && !em_entrada && !intruso && time.since(armado_em) >= ATRASO_SAIDA_MS) {
        em_entrada = alive
        entrada_em = time.ms()
    }
    checkpoint (em_entrada && time.since(entrada_em) >= ATRASO_ENTRADA_MS) {
        em_entrada = dead
        intruso = alive
    }
    risco_presenca = NORMAL
    checkpoint (em_entrada) {
        risco_presenca = ATENCAO
    } fallback checkpoint (intruso) {
        risco_presenca = ALARME
    }
}

// Converte uma leitura em % de molhado, de 0 (seco) a 100 (encharcado)
mission percentual_molhado(ration leitura, ration seco, ration molhado) -> ration {
    supply pct = ration((seco - leitura) * 100 / (seco - molhado))
    checkpoint (pct < 0) {
        pct = 0
    }
    checkpoint (pct > 100) {
        pct = 100
    }
    extract pct
}

// Sensor de chuva no telhado: avisa quando começa a chover
survivor sentinela_chuva {
    leitura_chuva = adc.read(radio(PINO_CHUVA))
    checkpoint (filtro_pronto) {
        media_chuva = media_chuva + ration((leitura_chuva - media_chuva) / FILTRO_MQ)
    } fallback {
        media_chuva = leitura_chuva
    }
    chuva_pct = percentual_molhado(media_chuva, CHUVA_SECO, CHUVA_MOLHADO)
    checkpoint (chuva_pct >= CHUVA_ATENCAO) {
        chovendo = alive
    } fallback checkpoint (chuva_pct < CHUVA_ATENCAO - HISTERESE_PCT) {
        chovendo = dead
    }
}

// Umidade do solo no quintal ou na encosta. Chuva + solo saturado é o que
// antecede um deslizamento; depois que a chuva para, o risco continua até
// o solo secar, por isso o alarme só desliga pela umidade.
survivor sentinela_solo {
    leitura_solo = adc.read(radio(PINO_SOLO))
    checkpoint (filtro_pronto) {
        media_solo = media_solo + ration((leitura_solo - media_solo) / FILTRO_MQ)
    } fallback {
        media_solo = leitura_solo
    }
    solo_pct = percentual_molhado(media_solo, SOLO_SECO, SOLO_MOLHADO)
    checkpoint (solo_pct >= SOLO_ATENCAO) {
        solo_encharcado = alive
    } fallback checkpoint (solo_pct < SOLO_ATENCAO - HISTERESE_PCT) {
        solo_encharcado = dead
    }
    checkpoint (chovendo && solo_pct >= SOLO_ALARME) {
        deslizamento = alive
    } fallback checkpoint (solo_pct < SOLO_ALARME - HISTERESE_PCT) {
        deslizamento = dead
    }
}

// Botão: cala o buzzer por SILENCIO_MS; o LED vermelho continua aceso
survivor vigia_botao {
    checkpoint (!silenciado && estado == ALARME && gpio.pressed(radio(PINO_BOTAO))) {
        silenciado = alive
        silencio_desde = time.ms()
        log_entry("[AEGIS] buzzer silenciado por", SILENCIO_MS / 1000, "s")
    }
    checkpoint (silenciado && time.since(silencio_desde) >= SILENCIO_MS) {
        silenciado = dead
    }
}

// ------------------------------------------------------------------
// Decisão: o pior risco vence. A ordem vai do menos ao mais grave, então
// o último checkpoint verdadeiro define o motivo exibido.
// ------------------------------------------------------------------
mission avaliar() {
    estado = NORMAL
    motivo = "tudo em ordem"
    checkpoint (risco_presenca == ATENCAO) {
        estado = ATENCAO
        motivo = "use a digital"
    }
    checkpoint (risco_ar == ATENCAO) {
        estado = ATENCAO
        motivo = "ar ruim"
    }
    checkpoint (chovendo) {
        estado = ATENCAO
        motivo = "chovendo"
    }
    checkpoint (solo_encharcado) {
        estado = ATENCAO
        motivo = "solo encharcado"
    }
    checkpoint (risco_calor == ATENCAO) {
        estado = ATENCAO
        motivo = "calor"
    }
    checkpoint (risco_calor == ALARME) {
        estado = ALARME
        motivo = "TEMP ALTA"
    }
    checkpoint (risco_presenca == ALARME) {
        estado = ALARME
        motivo = "INTRUSO"
    }
    checkpoint (risco_agua == ALARME) {
        estado = ALARME
        motivo = "ENCHENTE"
    }
    checkpoint (deslizamento) {
        estado = ALARME
        motivo = "RISCO DESLIZAMENTO"
    }
    checkpoint (risco_fumaca == ALARME) {
        estado = ALARME
        motivo = "FUMACA/GAS"
    }
}

// ------------------------------------------------------------------
// Saídas
// ------------------------------------------------------------------
mission acender(radio pino, status ligado) {
    checkpoint (ligado) {
        broadcast(radio(pino))
    } fallback {
        silence(radio(pino))
    }
}

// LEDs de estado e sirene de dois tons
mission sinalizar() {
    acender(LED_VERDE, estado == NORMAL)
    acender(LED_AMARELO, estado == ATENCAO)
    acender(LED_VERMELHO, estado == ALARME)
    checkpoint (estado == ALARME && !silenciado) {
        sirene_alta = !sirene_alta
        checkpoint (sirene_alta) {
            pwm.tone(radio(PINO_BUZZER), 2500)
        } fallback {
            pwm.tone(radio(PINO_BUZZER), 1500)
        }
    } fallback {
        pwm.off(radio(PINO_BUZZER))
    }
}

// Relé do exaustor: só para fumaça/gás (em enchente não ajuda) e fica
// ligado mais RELE_EXTRA_MS depois que a fumaça some. O botão de silenciar
// cala só o buzzer, não o exaustor.
mission acionar_rele() {
    checkpoint (risco_fumaca == ALARME) {
        houve_fumaca = alive
        ultima_fumaca = time.ms()
    }
    supply ligar = houve_fumaca && time.since(ultima_fumaca) < RELE_EXTRA_MS
    checkpoint (ligar != rele_ligado) {
        rele_ligado = ligar
        gpio.write(radio(PINO_RELE), ligar == RELE_ATIVO_EM_ALTO)
        checkpoint (ligar) {
            log_entry("[AEGIS] exaustor ligado")
        } fallback {
            log_entry("[AEGIS] exaustor desligado")
        }
    }
}

// Avisa no serial e pela rede só quando algo muda
mission relatar() {
    checkpoint (estado != estado_anterior || motivo != motivo_anterior) {
        log_entry("[AEGIS] estado:", NOMES_ESTADO[estado], "-", motivo)
        checkpoint (estado == NORMAL) {
            silenciado = dead
        }
        checkpoint (rede) {
            mqtt.publish("aegis/alerta", NOMES_ESTADO[estado] + ": " + motivo)
        }
        estado_anterior = estado
        motivo_anterior = motivo
    }
}

// OLED 128x64: 8 linhas de 16 caracteres
mission atualizar_tela() {
    display.write(0, "AEGIS " + NOMES_ESTADO[estado])
    display.write(1, motivo)
    display.write(2, "Chuva " + paper(chuva_pct) + "% S" + paper(solo_pct) + "%")
    display.write(3, "Fumaca  " + paper(media_fumaca))
    display.write(4, "Ar      " + paper(media_ar))
    display.write(5, "Agua    " + paper(ration(distancia_agua)) + " cm")
    display.write(6, "T " + paper(temperatura) + "C U " + paper(ration(umidade)) + "%")
    checkpoint (!aquecido) {
        display.write(7, "aquecendo MQ...")
    } fallback checkpoint (silenciado) {
        display.write(7, "BUZZER MUDO")
    } fallback checkpoint (rele_ligado) {
        display.write(7, "EXAUSTOR LIGADO")
    } fallback checkpoint (armado && time.since(armado_em) < ATRASO_SAIDA_MS) {
        display.write(7, "saia: " + paper(ration((ATRASO_SAIDA_MS - time.since(armado_em)) / 1000)) + " s")
    } fallback checkpoint (armado) {
        display.write(7, "ARMADO")
    } fallback checkpoint (rede) {
        display.write(7, "rede: online")
    } fallback {
        display.write(7, "rede: offline")
    }
    display.show()
}

// Telemetria periódica em JSON, para um painel externo
mission telemetria() {
    rede = mqtt.connected()
    checkpoint (rede && time.since(ultima_telemetria) >= TELEMETRIA_MS) {
        ultima_telemetria = time.ms()
        mqtt.publish("aegis/telemetria",
            "{\"estado\":" + paper(estado) +
            ",\"fumaca\":" + paper(media_fumaca) +
            ",\"ar\":" + paper(media_ar) +
            ",\"agua_cm\":" + paper(distancia_agua) +
            ",\"armado\":" + paper(ration(armado)) +
            ",\"chuva\":" + paper(chuva_pct) +
            ",\"solo\":" + paper(solo_pct) +
            ",\"temp\":" + paper(temperatura) +
            ",\"umid\":" + paper(umidade) + "}")
    }
}

// Leituras cruas no serial, para calibrar os limites com os sensores reais
mission depurar() {
    checkpoint (DEPURAR && time.since(ultima_depuracao) >= DEPURAR_MS) {
        ultima_depuracao = time.ms()
        log_entry("[leituras] fumaca", leitura_fumaca, "(media", media_fumaca,
                  "base", paper(base_fumaca) + ")",
                  "ar", leitura_ar, "(media", media_ar, "base", paper(base_ar) + ")",
                  "agua", distancia_agua, "cm",
                  "chuva", chuva_pct, "% solo", solo_pct, "%",
                  "temp", temperatura, "umid", umidade, "pir", presenca)
    }
}

// Um ciclo completo: ler, decidir, agir. Separado do laço para poder ser
// testado no PC um ciclo por vez (firmware/cenarios.py).
mission ciclo() {
    aquecido = time.since(inicio) >= AQUECIMENTO_MS
    checkpoint (!aquecido) {
        amostras = amostras + 1
    } fallback checkpoint (!base_registrada) {
        base_registrada = alive
        log_entry("[AEGIS] base de ar limpo: fumaca", base_fumaca, "ar", base_ar)
    }
    sentinela_fumaca()
    sentinela_ar()
    sentinela_chuva()
    sentinela_solo()
    filtro_pronto = alive
    sentinela_agua()
    sentinela_calor()
    vigia_digital()
    sentinela_presenca()
    vigia_botao()
    avaliar()
    sinalizar()
    acionar_rele()
    relatar()
    atualizar_tela()
    telemetria()
    depurar()
}

// ------------------------------------------------------------------
// Programa principal
// ------------------------------------------------------------------
chronicle {
    log_entry("[AEGIS] abrigo iniciando")
    gpio.write(radio(PINO_RELE), !RELE_ATIVO_EM_ALTO)   // relé desligado antes de tudo
    checkpoint (finger.begin(radio(PINO_DIGITAL_RX), radio(PINO_DIGITAL_TX))) {
        log_entry("[AEGIS] leitor de digital pronto")
    }
    inicio = time.ms()
    display.write(0, "AEGIS")
    display.write(2, "iniciando...")
    display.show()

    checkpoint (USAR_REDE) {
        checkpoint (wifi.connect(WIFI_SSID, WIFI_SENHA, 10000)) {
            rede = mqtt.connect(MQTT_BROKER)
        }
    }
    checkpoint (rede) {
        log_entry("[AEGIS] online: alertas tambem vao por MQTT")
    } fallback {
        log_entry("[AEGIS] modo offline: alertas so no local")
    }

    watch {
        ciclo()
        hide(CICLO_MS)
    }
}
